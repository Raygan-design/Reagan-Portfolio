# Public canonical site URL. Set to the deployed Vercel/custom domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PAYSTACK_SECRET_KEY=
# Public links. Blank links are deliberately not sent to guessed destinations.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TEAM_RAYGAN_URL=
NEXT_PUBLIC_GREYEND_URL=
NEXT_PUBLIC_RAYGAN_STUDIO_URL=
NEXT_PUBLIC_PODCAST_URL=
# Direct HTTPS video files, e.g. .mp4. Media dialogs retain a clear unavailable state until supplied.
NEXT_PUBLIC_STORY_VIDEO_URL=
NEXT_PUBLIC_PODCAST_VIDEO_URL=
NEXT_PUBLIC_REEL_1_URL=
NEXT_PUBLIC_REEL_2_URL=
NEXT_PUBLIC_REEL_3_URL=
